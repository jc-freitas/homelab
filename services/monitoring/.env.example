GRAFANA_ADMIN_PASSWORD=changeme
# Where the alerts come out. EVOLUTION_URL is the full sendText endpoint of a
# connected instance, not a base url -- the same value the host's lab-notify
# uses. Leaving a pair empty disables that transport instead of breaking it.
EVOLUTION_URL=
EVOLUTION_API_KEY=
ALERT_WHATSAPP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
