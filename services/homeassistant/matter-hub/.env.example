# The HA long-lived access token this needs is created in Home Assistant:
# Profile -> Security -> Long-lived access tokens.
HAMH_HOME_ASSISTANT_URL=http://localhost:8123
HAMH_HOME_ASSISTANT_ACCESS_TOKEN=
# Matter commissioning advertises on this interface only -- a wrong one
# makes Alexa never find the bridge.
HAMH_MDNS_NETWORK_INTERFACE=
