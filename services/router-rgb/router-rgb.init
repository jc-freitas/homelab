#!/bin/sh /etc/rc.common
# procd owns the daemon and its MQTT subscriber. Start after the normal LED service.
START=99
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/router-rgb
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 5
    procd_close_instance
}
