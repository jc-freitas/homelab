{
	auto_https off
}

# Explicit listen addresses, excluding 10.0.1.1 (management VLAN — reserved
# for LuCI/uhttpd). Covers infra/services/lan/iot VLAN gateways plus the
# router's Tailscale IP, so *.local resolves the same way on LAN and tailnet.
(lan) {
	bind 10.0.10.1 10.0.20.1 10.0.30.1 10.0.40.1 100.118.103.46
}

http://searxng.local {
	import lan
	reverse_proxy 10.0.20.2:8888
}

